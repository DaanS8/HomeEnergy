{
  "name": "Home Energy - Belgian day-ahead report",
  "nodes": [
    {
      "id": "run-manually",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        0,
        0
      ]
    },
    {
      "id": "daily-at-16-brussels",
      "name": "Daily at 16 Brussels",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 16,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "position": [
        0,
        200
      ]
    },
    {
      "id": "settings",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "base-url",
              "name": "base_url",
              "value": "http://192.168.0.10:18000",
              "type": "string"
            },
            {
              "id": "date",
              "name": "date",
              "value": "={{ $now.setZone('Europe/Brussels').plus({ days: 1 }).toISODate() }}",
              "type": "string"
            },
            {
              "id": "threshold",
              "name": "threshold_eur_per_mwh",
              "value": "300",
              "type": "string"
            },
            {
              "id": "attempt",
              "name": "attempt",
              "value": 0,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "position": [
        240,
        100
      ]
    },
    {
      "id": "request-context",
      "name": "Request context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { ...$json, attempt: ($json.attempt ?? 0) + 1 } };"
      },
      "position": [
        480,
        100
      ]
    },
    {
      "id": "prepare-report",
      "name": "Prepare report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base_url + '/api/v1/reports/day-ahead' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { date: $json.date, threshold_eur_per_mwh: $json.threshold_eur_per_mwh } }}",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
        720,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "id": "evaluate-response",
      "name": "Evaluate response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const context = $('Request context').item.json;\nconst body = $json.body ?? { status: 'error', code: 'transport_error', error: 'Home Energy could not be reached.', retryable: true };\nconst complete = $json.statusCode === 200 && ['success', 'warning'].includes(body.status);\nreturn { json: { ...context, body, statusCode: $json.statusCode ?? 0, complete, can_retry: !complete && body.retryable === true && context.attempt < 6 } };"
      },
      "position": [
        960,
        100
      ]
    },
    {
      "id": "report-ready",
      "name": "Report ready",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.complete }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        1200,
        100
      ]
    },
    {
      "id": "decode-png",
      "name": "Decode PNG",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "parameters": {
        "operation": "toBinary",
        "sourceProperty": "body.image",
        "binaryPropertyName": "chart",
        "options": {
          "fileName": "={{ $json.body.image_filename }}",
          "mimeType": "image/png"
        }
      },
      "position": [
        1440,
        0
      ]
    },
    {
      "id": "report-and-attachment",
      "name": "Report and attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { image, ...report } = $('Evaluate response').item.json.body;\nreturn { json: report, binary: $binary };"
      },
      "position": [
        1680,
        0
      ]
    },
    {
      "id": "retry-allowed",
      "name": "Retry allowed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.can_retry }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        1440,
        240
      ]
    },
    {
      "id": "wait-10-minutes",
      "name": "Wait 10 minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "parameters": {
        "amount": 10,
        "unit": "minutes"
      },
      "position": [
        1680,
        200
      ],
      "webhookId": "dce52030-87da-471e-9b41-643a3415e51d"
    },
    {
      "id": "report-failed",
      "name": "Report failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "parameters": {
        "errorMessage": "={{ 'Home Energy ' + $json.body.code + ': ' + $json.body.error + ' (attempt ' + $json.attempt + ')' }}"
      },
      "position": [
        1680,
        400
      ]
    }
  ],
  "connections": {
    "Run manually": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily at 16 Brussels": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Settings": {
      "main": [
        [
          {
            "node": "Request context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request context": {
      "main": [
        [
          {
            "node": "Prepare report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare report": {
      "main": [
        [
          {
            "node": "Evaluate response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate response": {
      "main": [
        [
          {
            "node": "Report ready",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report ready": {
      "main": [
        [
          {
            "node": "Decode PNG",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Retry allowed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Decode PNG": {
      "main": [
        [
          {
            "node": "Report and attachment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Retry allowed": {
      "main": [
        [
          {
            "node": "Wait 10 minutes",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 10 minutes": {
      "main": [
        [
          {
            "node": "Request context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Brussels"
  },
  "pinData": {},
  "tags": []
}
