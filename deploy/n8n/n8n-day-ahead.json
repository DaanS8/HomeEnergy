{
  "name": "Daily Energy Price Monitoring",
  "nodes": [
    {
      "id": "run-manually",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        0,
        0
      ]
    },
    {
      "id": "2cfb7198-c9a6-4b83-bd28-0e014970ff7c",
      "name": "7PM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 19,
              "field": "days",
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "position": [
        0,
        200
      ]
    },
    {
      "id": "settings",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "base-url",
              "name": "base_url",
              "value": "http://192.168.0.10:18000",
              "type": "string"
            },
            {
              "id": "date",
              "name": "date",
              "value": "={{ $now.setZone('Europe/Brussels').plus({ days: 1 }).toISODate() }}",
              "type": "string"
            },
            {
              "id": "threshold",
              "name": "threshold_eur_per_mwh",
              "value": "300",
              "type": "string"
            },
            {
              "id": "attempt",
              "name": "attempt",
              "value": 0,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "position": [
        240,
        100
      ]
    },
    {
      "id": "request-context",
      "name": "Request context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { ...$json, attempt: ($json.attempt ?? 0) + 1 } };"
      },
      "position": [
        480,
        100
      ]
    },
    {
      "id": "prepare-report",
      "name": "Prepare report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base_url + '/api/v1/reports/day-ahead' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { date: $json.date, threshold_eur_per_mwh: $json.threshold_eur_per_mwh } }}",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "authentication": "none"
      },
      "position": [
        720,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "id": "evaluate-response",
      "name": "Evaluate response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const context = $('Request context').item.json;\nconst statusCode = $json.statusCode ?? 0;\nconst payload = $json.body;\nconst validBody = payload && typeof payload === 'object' && !Array.isArray(payload);\nconst body = validBody ? payload : {\n  status: 'error',\n  code: statusCode === 0 ? 'transport_error' : 'invalid_response',\n  error: statusCode === 0 ? 'Home Energy could not be reached.' : 'Home Energy returned an invalid response.',\n  retryable: statusCode === 0 || statusCode >= 500,\n};\nconst complete = statusCode === 200 && ['success', 'warning'].includes(body.status)\n  && typeof body.image === 'string' && body.image.length > 0;\nconst error = `${body.code ?? 'invalid_response'}: ${body.error ?? 'Home Energy did not return a completed report.'} (attempt ${context.attempt})`;\nreturn { json: { ...context, body, statusCode, complete, error,\n  can_retry: !complete && body.retryable === true && context.attempt < 6 } };"
      },
      "position": [
        960,
        100
      ]
    },
    {
      "id": "report-ready",
      "name": "Report ready",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.complete }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        1200,
        100
      ]
    },
    {
      "id": "decode-png",
      "name": "Decode PNG",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "parameters": {
        "operation": "toBinary",
        "sourceProperty": "body.image",
        "binaryPropertyName": "image_file",
        "options": {
          "fileName": "={{ $json.body.image_filename }}",
          "mimeType": "image/png"
        }
      },
      "position": [
        1440,
        0
      ]
    },
    {
      "id": "report-and-attachment",
      "name": "Report and attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { image, ...report } = $('Evaluate response').item.json.body;\nreturn { json: report, binary: $binary };"
      },
      "position": [
        1680,
        0
      ]
    },
    {
      "id": "retry-allowed",
      "name": "Retry allowed",
      "type": "n8n-nodes-base.if",
