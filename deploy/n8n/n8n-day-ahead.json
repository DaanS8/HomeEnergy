            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.can_retry }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        1440,
        240
      ]
    },
    {
