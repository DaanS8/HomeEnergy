      "position": [
        480,
        100
      ],
      "notes": "Leave test_date blank: manual runs publish every day from start_date through two days ago in Brussels; the daily schedule publishes only two days ago. Set test_date to YYYY-MM-DD for a single report, then clear it before enabling the schedule. Configure the destination directly in both Discord nodes. Running the backfill again republishes the selected dates.",
      "notesInFlow": true
    },
    {
      "id": "b253c7de-e791-4e0d-819f-6dc9c31038c4",
      "name": "Backfill mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { ...$json, backfill: true } };"
      },
      "position": [
        240,
        0
      ]
    },
    {
      "id": "025da9b4-9b1d-4115-9aef-e77024a5cfc8",
      "name": "Report dates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const zone = 'Europe/Brussels';\nconst end = $now.setZone(zone).startOf('day').minus({ days: 2 }).toISODate();\nreturn $input.all().flatMap((item, inputIndex) => {\n  const context = item.json;\n  const override = String(context.test_date ?? '').trim();\n  const first = override || (context.backfill === true ? String(context.start_date ?? '').trim() : end);\n  let cursor = DateTime.fromISO(first, { zone }).startOf('day');\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(first) || !cursor.isValid) {\n    throw new Error('Use a valid start_date or test_date in YYYY-MM-DD format.');\n  }\n  if (override && first > end) {\n    throw new Error('EV dates must be at least two days ago in Europe/Brussels.');\n  }\n  const last = override || end;\n  const dates = [];\n  while (cursor.toISODate() <= last) {\n    dates.push({ json: { ...context, date: cursor.toISODate(), attempt: 0 }, pairedItem: { item: inputIndex } });\n    cursor = cursor.plus({ days: 1 });\n  }\n  return dates;\n});"
      },
      "position": [
        720,
        100
      ],
      "notes": "Snapshot the inclusive date range once per execution. Dates advance by Brussels calendar days, including DST changes.",
      "notesInFlow": true
    },
    {
      "id": "a8f1bda9-6f69-4c23-a6c1-cfe0b7cb89ab",
      "name": "Loop over days",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {
          "reset": false
        }
      },
      "position": [
        960,
        100
      ],
      "notes": "Publish one day at a time. Advance only after Discord confirms delivery; exhausted report retries alert and stop the backfill.",
      "notesInFlow": true
    },
    {
      "id": "4e8a2036-431e-4be2-8490-f1b43cb8ea3b",
      "name": "Request context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const attempt = ($json.attempt ?? 0) + 1;\nconst date = $json.date;\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || !DateTime.fromISO(date, { zone: 'Europe/Brussels' }).isValid) {\n  throw new Error('Expected a valid report date in YYYY-MM-DD format.');\n}\nreturn { json: { ...$json, date, attempt } };"
      },
      "position": [
        1200,
        100
      ]
    },
    {
      "id": "94febcf3-76a6-4095-aeb1-bd937a58a1cf",
      "name": "Prepare report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base_url.replace(/\\/$/, '') + '/api/v1/reports/ev/daily' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { date: $json.date } }}",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "authentication": "none"
      },
      "position": [
        1440,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "id": "052403ab-cb36-4857-b539-00f330fe31c5",
      "name": "Evaluate response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const context = $('Request context').item.json;\nconst statusCode = $json.statusCode ?? 0;\nconst payload = $json.body;\nconst validBody = payload && typeof payload === 'object' && !Array.isArray(payload);\nconst body = validBody ? payload : {\n  status: 'error',\n  code: statusCode === 0 ? 'transport_error' : 'invalid_response',\n  error: statusCode === 0 ? 'Home Energy could not be reached.' : 'Home Energy returned an invalid response.',\n  retryable: statusCode === 0 || statusCode >= 500,\n};\nconst complete = statusCode === 200 && (body.status === 'complete')\n  && body.date === context.date && body.image_mime_type === 'image/png'\n  && typeof body.image_filename === 'string' && body.image_filename.endsWith('.png')\n  && typeof body.image === 'string' && body.image.startsWith('iVBORw0KGgo');\nconst error = `${body.code ?? 'invalid_response'}: ${body.error ?? 'Home Energy did not return a completed PNG report.'} (date ${context.date}, attempt ${context.attempt})`;\nreturn { json: { ...context, body, statusCode, complete, error,\n  can_retry: !complete && body.retryable === true && context.attempt < 6 } };"
      },
      "position": [
        1680,
        100
      ]
    },
    {
      "id": "2c5c7d40-f7db-47b6-8672-46723d405edb",
      "name": "Report ready",
