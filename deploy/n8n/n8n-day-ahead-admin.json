{
  "name": "Daily Energy Prices - Admin",
  "nodes": [
    {
      "id": "1d248f36-9b4b-4f83-affb-f25e755da7ca",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        0,
        0
      ]
    },
    {
      "id": "237f44d2-9d88-4a58-8220-6c2698190cf4",
      "name": "Daily schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 19,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "position": [
        0,
        200
      ]
    },
    {
      "id": "96988944-9f3f-4049-a4c9-2be5e4f5da5d",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "base-url",
              "name": "base_url",
              "value": "http://192.168.0.10:18000",
              "type": "string"
            },
            {
              "id": "test-date",
              "name": "test_date",
              "value": "",
              "type": "string"
            },
            {
              "id": "date-offset",
              "name": "date_offset_days",
              "value": 1,
              "type": "number"
            },
            {
              "id": "guild",
              "name": "guild_id",
              "value": "1532853070281707561",
              "type": "string"
            },
            {
              "id": "admin-channel",
              "name": "admin_channel_id",
              "value": "1532856135546044607",
              "type": "string"
            },
            {
              "id": "attempt",
              "name": "attempt",
              "value": 0,
              "type": "number"
            },
            {
              "id": "threshold",
              "name": "threshold_eur_per_mwh",
              "value": "300",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "position": [
        240,
        100
      ],
      "notes": "Leave test_date blank for the scheduled date. For testing, enter YYYY-MM-DD and run manually. Clear test_date before enabling the schedule. EV dates must be at least two days ago. Both image and failure messages go to admin_channel_id.",
      "notesInFlow": true
    },
    {
      "id": "47404a97-e9aa-4549-8956-65c4e1bb7949",
      "name": "Request context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const attempt = ($json.attempt ?? 0) + 1;\nconst override = String($json.test_date ?? '').trim();\nconst date = $json.date ?? (override || $now.setZone('Europe/Brussels').plus({ days: $json.date_offset_days }).toISODate());\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || !DateTime.fromISO(date, { zone: 'Europe/Brussels' }).isValid) {\n  throw new Error('Use a valid test_date in YYYY-MM-DD format.');\n}\nreturn { json: { ...$json, date, attempt } };"
      },
      "position": [
        480,
        100
      ]
    },
    {
      "id": "5f1ea425-91fe-4d20-9735-4369c9723a73",
      "name": "Prepare report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base_url.replace(/\\/$/, '') + '/api/v1/reports/day-ahead' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { date: $json.date, threshold_eur_per_mwh: $json.threshold_eur_per_mwh } }}",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "authentication": "none"
      },
      "position": [
        720,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "id": "edb6f6ed-ac04-4fc3-9ee0-b0a9ed50926e",
      "name": "Evaluate response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const context = $('Request context').item.json;\nconst statusCode = $json.statusCode ?? 0;\nconst payload = $json.body;\nconst validBody = payload && typeof payload === 'object' && !Array.isArray(payload);\nconst body = validBody ? payload : {\n  status: 'error',\n  code: statusCode === 0 ? 'transport_error' : 'invalid_response',\n  error: statusCode === 0 ? 'Home Energy could not be reached.' : 'Home Energy returned an invalid response.',\n  retryable: statusCode === 0 || statusCode >= 500,\n};\nconst complete = statusCode === 200 && (['success', 'warning'].includes(body.status))\n  && body.date === context.date && body.image_mime_type === 'image/png'\n  && typeof body.image_filename === 'string' && body.image_filename.endsWith('.png')\n  && typeof body.image === 'string' && body.image.startsWith('iVBORw0KGgo');\nconst error = `${body.code ?? 'invalid_response'}: ${body.error ?? 'Home Energy did not return a completed PNG report.'} (date ${context.date}, attempt ${context.attempt})`;\nreturn { json: { ...context, body, statusCode, complete, error,\n  can_retry: !complete && body.retryable === true && context.attempt < 6 } };"
      },
      "position": [
        960,
        100
      ]
    },
    {
      "id": "3c09cc90-10f4-46ac-a17f-58cc30a8c0d6",
      "name": "Report ready",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.complete }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        1200,
        100
      ]
    },
    {
      "id": "c950906a-37ee-4ce2-b629-08b39ed371b5",
      "name": "Decode PNG",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "parameters": {
        "operation": "toBinary",
        "sourceProperty": "body.image",
        "binaryPropertyName": "image_file",
        "options": {
          "fileName": "={{ $json.body.image_filename }}",
          "mimeType": "image/png"
        }
      },
      "position": [
        1440,
        0
      ]
    },
    {
      "id": "dc5016fa-b125-483a-8b55-41c8e5df1026",
      "name": "Report and attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { image, ...report } = $('Evaluate response').item.json.body;\nconst { guild_id, admin_channel_id } = $('Request context').item.json;\nreturn { json: { ...report, guild_id, admin_channel_id }, binary: $binary };"
      },
      "position": [
        1680,
        0
      ]
    },
    {
      "id": "dc880c78-c7e2-48e1-aac2-acf66d010909",
      "name": "Retry allowed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.can_retry }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        1440,
        240
      ]
    },
    {
      "id": "8a133ca9-73ce-4563-a5fe-123f095b57de",
      "name": "Wait 10 minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "parameters": {
        "amount": 10,
        "unit": "minutes"
      },
      "position": [
        1680,
