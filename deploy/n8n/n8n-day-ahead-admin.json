      ],
      "webhookId": "20f1bd9e-5505-4dce-a4ae-40bd4cee14c2"
    },
    {
      "id": "6897f8bc-557a-4a53-a5ad-ad46faae30b6",
      "name": "Report failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "parameters": {
        "errorMessage": "={{ $('Evaluate response').item.json.error }}"
